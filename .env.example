# =============================================================================
# Telegram File Processing & Authorized Security Testing Bot
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Telegram ---
# Bot token from @BotFather. Required for the bot to run (not needed for tests).
BOT_TOKEN=

# Optional: base URL of a self-hosted local Bot API server (enables >50MB files).
# Leave empty to use the official Telegram Bot API.
TELEGRAM_API_BASE=

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=./var/logs/bot.log

# --- Access control / licensing ---
# Telegram user ids that are always admins (comma-separated). The first user
# can also run /claimadmin once when no admin exists yet.
ADMIN_IDS=
# When true, only admins and users with an active access key may use the bot.
# (Can also be toggled live from the admin panel.)
ACCESS_REQUIRED=true
# Days of access granted when an admin approves a /request.
APPROVAL_DAYS=7
# Prefix for generated keys, e.g. Lord_Jat -> LORD_JAT-XXXX-XXXX-XXXX
KEY_PREFIX=Lord_Jat

# --- Collection channel/group (auto-forward incoming files/results) ---
# @username or -100... id. The bot must be an admin/member of it.
FORWARD_CHANNEL_ID=
FORWARD_UPLOADS=true
FORWARD_RESULTS=true
# Optional separate channel for scrape output (raw + cleaned, pinned).
# Falls back to FORWARD_CHANNEL_ID when empty.
SCRAPE_CHANNEL_ID=
# Max sources handled per scrape run (paced to stay within Telegram limits).
SCRAPE_MAX_SOURCES=4
# Shown in the welcome message + Developer button.
DEVELOPER_CONTACT=Lord_Jat
# Background sweep interval that forwards any pending files (hours).
FORWARD_INTERVAL_HOURS=6

# --- Database ---
# PostgreSQL (required in production):
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/tgbot
# For local tests you may use:
# DATABASE_URL=sqlite+aiosqlite:///./var/test.db

# --- Storage ---
# Root directory for per-user sandboxes and temp files.
STORAGE_ROOT=./var/storage

# Max upload size in MB (Telegram's own bot download cap is 20 MB).
MAX_FILE_SIZE_MB=10

# Per-user disk quota in MB (temporary working set).
USER_DISK_QUOTA_MB=5000

# Appended to result file names, e.g. "cards_clean@Lord_Jat.txt".
FILE_SUFFIX=@Lord_Jat

# --- Cleanup / retention ---
# Auto-cleanup of temporary files, in minutes (used as the default for new users).
CLEANUP_DEFAULT_MINUTES=10

# --- Rate limiting ---
# Requests per minute, per user.
RATE_LIMIT_PER_MINUTE=30

# --- Background jobs ---
WORKER_CONCURRENCY=4

# --- Document conversion ---
# Path to the LibreOffice/soffice binary (needed only for legacy .doc files).
LIBREOFFICE_PATH=soffice
# Hard timeout (seconds) for the LibreOffice conversion subprocess.
LIBREOFFICE_TIMEOUT_SECONDS=120

# --- Custom / premium emoji (optional) ---
# JSON map of abstract emoji name -> Telegram custom emoji id.
# Example: {"SUCCESS": "5368324170671202286"}
CUSTOM_EMOJI_IDS={}

# --- Authorized Telegram sources (optional) ---
# Required ONLY if you want /scrape and /private_scrape. Get these from
# https://my.telegram.org. NEVER send credentials/OTPs to the bot.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Where Telethon *.session files are stored (keep private, never commit).
TELEGRAM_SESSION_DIR=./var/sessions
# Account metadata registry (labels + status only; no secrets).
TELEGRAM_ACCOUNTS_FILE=./var/telegram_accounts.json
